# Salin menjadi .env lalu ganti password!   cp .env.example .env
# Password: pakai nilai acak yang panjang, mis.  openssl rand -base64 24

DB_NAME=chetaks
DB_USER=chetaks
DB_PASS=GANTI_PASSWORD_APP
DB_ROOT_PASS=GANTI_PASSWORD_ROOT

# Alamat bind aplikasi di host. 127.0.0.1 = hanya bisa diakses lewat reverse proxy (disarankan di VPS).
# Ganti 0.0.0.0 kalau ingin langsung terbuka ke internet tanpa reverse proxy (tidak disarankan).
APP_BIND=127.0.0.1
APP_PORT=8080
